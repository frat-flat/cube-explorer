# Neon のデータベース(Neon の画面の「Connect」で出る接続文字列。Pooled connection のもの)
DATABASE_URL=

# Neon Auth の URL(Neon の画面の「Auth」→「Configuration」にある Auth URL)
NEON_AUTH_BASE_URL=

# ログインして見てよいメールアドレス(カンマ区切りで複数可)
ALLOWED_EMAILS=

# ログインのクッキーに使う秘密の値(npm run local が自動で作る)
# NEON_AUTH_COOKIE_SECRET=

# 何も書かずに npm run dev すると、ローカルの Supabase(npx supabase start)の DB を使い、ログインなしで動く
