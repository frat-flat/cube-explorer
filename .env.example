# Neon Auth の URL(Neon の画面の「Auth」→「Configuration」にある Auth URL)
NEON_AUTH_BASE_URL=

# ログインして見てよいメールアドレス(カンマ区切りで複数可)
ALLOWED_EMAILS=

# ログインのクッキーに使う秘密の値(npm run local が自動で作る)
# NEON_AUTH_COOKIE_SECRET=

# スプシのリンクを読むためのシステム用アカウント(Google Cloud のサービスアカウントの鍵 JSON を1行でそのまま)
# 読みたいスプシは、この JSON の client_email に閲覧者として共有する。未設定でもほかの機能は動く
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 何も書かずに npm run dev すると、ログインなしで動く

# ---------- 4D Base の芯の表(fourdb)。/migrate などの新しい画面で使う(docs/deployment/ENVIRONMENT.md) ----------
# アプリが接続する実行用の役割の接続先(表の持ち主・superuser・BYPASSRLS の役割にしない)。未設定なら新しい画面は「未設定」と出る
# FOURDB_DATABASE_URL=
# 表を作る・更新するとき(npm run fourdb:migrate)だけに使う、表の持ち主の接続先。アプリには入れない
# FOURDB_ADMIN_URL=
# FOURDB_APP_ROLE=
# 試験用: スプシの代わりに読むフォルダ(本番では使えない)
# FOURDB_SHEETS_FIXTURE_DIR=e2e/fixtures/sheets
